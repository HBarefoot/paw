# Paw Environment Overrides
#
# NOTE: You don't need a .env file! Run `paw init` for interactive setup.
# Credentials are stored securely in ~/.paw/credentials.json
#
# These env vars override stored credentials (useful for CI/Docker):

# ANTHROPIC_API_KEY=sk-ant-...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_SIGNING_SECRET=...

# Runtime settings
# PAW_LOG_LEVEL=info
# PAW_DB_PATH=./data/paw.db
# PAW_AI_MODEL=claude-sonnet-4-5-20250929

# Integrations — set these to auto-enable an integration from env alone
# (handy for container deploys). Partial sets do nothing; the vault overlay,
# if present, still wins for the secret values.

# HubSpot (token alone enables it)
# PAW_HUBSPOT_TOKEN=pat-...

# Supabase (both required)
# PAW_SUPABASE_URL=https://<ref>.supabase.co
# PAW_SUPABASE_SERVICE_KEY=...

# WordPress (all three required)
# PAW_WORDPRESS_URL=https://example.com
# PAW_WORDPRESS_USERNAME=admin
# PAW_WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Vision routing (both required) — provider is claude|ollama|openai|gemini
# PAW_VISION_PROVIDER=claude
# PAW_VISION_MODEL=claude-sonnet-4-5-20250929
